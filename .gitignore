node_modules/
.pnpm-store/
lib/
dist/
out/
*.log
.DS_Store

# vitest v8 覆盖率输出（test:coverage 产物，CI 只看门槛、不入库）
coverage/

# vendor 全部由 scripts/sync-upstream.ts 从锁定的 submodule 重新生成
# （上游包 tarball + dsh-cli 独立安装产物）；仅 dsh-cli 的 lockfile 入库，
# 锁定 registry 侧的可传递依赖解析
vendor/*
!vendor/dsh-cli
vendor/dsh-cli/*
!vendor/dsh-cli/pnpm-lock.yaml

# Electron 打包产物
apps/desktop/release/
# dsh-cli 运行时单 tar（stage-runtime-archive.ts 产出，随包携带、首启解压）
apps/desktop/.runtime-archive/

# CI 失败诊断（日志、截图、探针输出）
.ci-artifacts/

# 本地视觉调试帧与 Codex/dsh 集成运行态
.tmp-video/
.zcode/

# 本地开发数据（DSH_HOME 隔离目录的本地覆盖）
.dsh-home-dev/

# 敏感文件兜底（security_best_practices_report.md 行动项 #1）：防未来误提交密钥。
# 模式与报告建议一致；!.env.example / !patches/*.patch 为模板与补丁队列放行。
.env
.env.*
!.env.example
*.pem
*.key
!patches/*.patch
*.p12
*.pfx
