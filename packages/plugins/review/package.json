{
  "name": "@dsh-desktop/review",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "审查面板（人审 agent 改动）：会话 write/edit 的 hunk diff 聚合 + git 工作区未提交改动源，按文件汇总成编辑时间线；行级评论草稿一键回灌会话，单文件撤销（tracked restore 自 HEAD，untracked 删除）。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@dsh-desktop/panel-shell",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "external": [
        "@dsh-desktop/panel-shell/client"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsx ./build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@dsh-desktop/bridge": "workspace:*",
    "@dsh-desktop/panel-shell": "workspace:*",
    "@dsh-desktop/plugin-kit": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-api-session-controller",
    "@deepseek-ai/cordis": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/cordis"
  }
}
