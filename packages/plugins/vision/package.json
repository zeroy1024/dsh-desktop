{
  "name": "@dsh-desktop/vision",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "为不支持图片输入的 dsh 文本模型补充透明的视觉理解能力。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsx ./build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.2-rc.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/schemastery",
    "@deepseek-ai/dsh-storage-domain": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-storage-domain",
    "zod": "link:../../../vendor/dsh-cli/node_modules/zod"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-system-prompt": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-system-prompt",
    "@deepseek-ai/dsh-llm-pi-ai": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-llm-pi-ai",
    "@dsh-desktop/plugin-kit": "workspace:*",
    "@deepseek-ai/cordis": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/cordis",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-credentials": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-credentials",
    "@deepseek-ai/dsh-launch-environment": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-launch-environment",
    "@deepseek-ai/dsh-llm": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-llm",
    "@deepseek-ai/dsh-settings": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-settings",
    "@deepseek-ai/dsh-tools": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-tools",
    "@deepseek-ai/dsh-agent": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-agent",
    "@deepseek-ai/dsh-session": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-session",
    "@deepseek-ai/dsh-storage-domain": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-storage-domain"
  }
}
