{
  "name": "@dsh-desktop/hello-panel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "P2 示例内置插件：在 shell.overlay 挂一块可见徽章，用来验收 desktop profile 通道。",
  "dshDesktop": {
    "enabled": false
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsx ./build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dsh-desktop/plugin-kit": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
