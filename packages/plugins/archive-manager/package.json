{
  "name": "@dsh-desktop/archive-manager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "归档管理：设置面板查看归档会话并一键恢复（unarchive），走 webServer 同源路由 + registry 运行时 setState。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsx ./build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.2-rc.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-storage-domain",
    "zod": "link:../../../vendor/dsh-cli/node_modules/zod"
  },
  "devDependencies": {
    "@dsh-desktop/plugin-kit": "workspace:*",
    "@deepseek-ai/cordis": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-host-webserver": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-host-webserver",
    "@deepseek-ai/dsh-workspace": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-workspace",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
