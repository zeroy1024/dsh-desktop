{
  "name": "@dsh-desktop/session-actions",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "会话行操作：导出会话日志与悬停快速归档。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsx ./build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@dsh-desktop/plugin-kit": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "react": "^18.3.1",
    "@deepseek-ai/dsh-client-ui-workspace": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-client-ui-workspace"
  }
}
