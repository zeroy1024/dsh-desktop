{
  "name": "@dsh-desktop/web-search",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "可配置的 DSH 联网搜索能力补全：通过辅助模型的原生 web search 为主模型提供结构化来源。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsx ./build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-web": "^0.1.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/schemastery"
  },
  "devDependencies": {
    "@dsh-desktop/plugin-kit": "workspace:*",
    "@deepseek-ai/cordis": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-credentials": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-credentials",
    "@deepseek-ai/dsh-launch-environment": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-launch-environment",
    "@deepseek-ai/dsh-settings": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-settings",
    "@deepseek-ai/dsh-web": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-web",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
