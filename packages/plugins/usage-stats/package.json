{
  "name": "@dsh-desktop/usage-stats",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "用量统计：按 (provider, model) 聚合会话 token 账目（未缓存输入/缓存读/缓存写/输出/命中率），设置面板展示概览、热力图、趋势与明细表。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsx ./build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.2-rc.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-storage-domain",
    "@deepseek-ai/dsh-token-meter": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-token-meter",
    "zod": "link:../../../vendor/dsh-cli/node_modules/zod"
  },
  "devDependencies": {
    "@dsh-desktop/plugin-kit": "workspace:*",
    "@dsh-desktop/bridge": "workspace:*",
    "@deepseek-ai/cordis": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-host-webserver": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-host-webserver",
    "@deepseek-ai/dsh-session": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-session",
    "@deepseek-ai/dsh-session-persistence": "link:../../../vendor/dsh-cli/node_modules/@deepseek-ai/dsh-session-persistence",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
