diff --git a/packages/session-query/session-query-sqlite/tests/document-projection.spec.ts b/packages/session-query/session-query-sqlite/tests/document-projection.spec.ts
new file mode 100644
index 0000000..0e2742a
--- /dev/null
+++ b/packages/session-query/session-query-sqlite/tests/document-projection.spec.ts
@@ -0,0 +1,65 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import { Context, type Fiber } from '@deepseek-ai/cordis'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { Session, SessionId, SessionSeq, type SessionEvent } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import SqliteSessionQueryEngine from '@deepseek-ai/dsh-session-query-sqlite'
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+class FirstDocumentQuery extends SqliteSessionQueryEngine {
+  protected override get searchDocumentVersion(): string { return 'first-document-v1' }
+  protected override buildSearchDocuments(id: SessionId, events: readonly SessionEvent[]) {
+    return super.buildSearchDocuments(id, events).filter(document => document.seq === 0)
+  }
+}
+
+const fibers: Fiber[] = []
+const paths: string[] = []
+afterEach(async () => {
+  for (const fiber of fibers.splice(0).toReversed()) await fiber.dispose()
+  for (const path of paths.splice(0)) await rm(path, { recursive: true, force: true })
+})
+
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-document-projection-'))
+  paths.push(root)
+  const ctx = new Context()
+  fibers.push(await ctx.plugin(SessionProjectionRegistry))
+  fibers.push(await ctx.plugin(SessionStore))
+  fibers.push(await ctx.plugin(JsonlSessionPersistence, { root: join(root, 'sessions'), compression: 'none' }))
+  const session = Session.create(SessionId('documents'))
+  for (const text of ['retained needle', 'excluded needle']) {
+    session.append('user/message', createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }), { surfaceOp: 'append' })
+  }
+  await ctx.sessionPersistence.create(session.header)
+  await ctx.sessionPersistence.append(session.id, session.snapshotEvents())
+  return { ctx, session, config: { path: join(root, 'query.db') } }
+}
+
+describe('semantic-document provider extension', () => {
+  it('shares filtering with full-text indexing, without changing exact history reads', async () => {
+    const { ctx, session, config } = await fixture()
+    fibers.push(await ctx.plugin(FirstDocumentQuery, config))
+    expect((await ctx.sessionQuery.searchEvents({ sessionId: session.id, query: 'needle' })).items.map(hit => hit.seq)).toEqual([0])
+    expect((await ctx.sessionQuery.searchSessions({ query: 'excluded' })).items).toEqual([])
+    expect((await ctx.sessionQuery.filterEvents(session.id, [])).map(document => document.seq)).toEqual([0])
+    expect((await ctx.sessionQuery.readEvent({ sessionId: session.id, seq: SessionSeq(1) })).target.data).toMatchObject({ content: [{ text: 'excluded needle' }] })
+    const live = ctx.sessions.create(SessionId('live-documents'), { seed: session.snapshotEvents() })
+    expect((await ctx.sessionQuery.searchEvents({ sessionId: live.id, query: 'excluded' })).items).toEqual([])
+  })
+
+  it('rebuilds unchanged persisted logs when switching projection versions in either direction', async () => {
+    const { ctx, session, config } = await fixture()
+    const native = await ctx.plugin(SqliteSessionQueryEngine, config)
+    expect((await ctx.sessionQuery.searchEvents({ sessionId: session.id, query: 'needle' })).items).toHaveLength(2)
+    await native.dispose()
+    const projected = await ctx.plugin(FirstDocumentQuery, config)
+    expect((await ctx.sessionQuery.searchEvents({ sessionId: session.id, query: 'needle' })).items.map(hit => hit.seq)).toEqual([0])
+    await projected.dispose()
+    fibers.push(await ctx.plugin(SqliteSessionQueryEngine, config))
+    expect((await ctx.sessionQuery.searchEvents({ sessionId: session.id, query: 'needle' })).items).toHaveLength(2)
+  })
+})
