+import { readFileSync } from 'node:fs'
+import { describe, expect, it, vi } from 'vitest'
+import * as yaml from 'js-yaml'
+import { applyEntryPatches, entryListSchema } from '@deepseek-ai/cordis-plugin-include'
+import type { PatchOptions } from '@deepseek-ai/cordis-plugin-include'
+import type { EntryOptions } from '@deepseek-ai/cordis-plugin-loader'
+
+const ORIGINAL = '@deepseek-ai/dsh-session-query-sqlite'
+const REPLACEMENT = '@example/projected-session-query'
+const load = (path: string): PatchOptions[] => yaml.load(readFileSync(new URL(path, import.meta.url), 'utf8'),
+  { schema: entryListSchema }) as PatchOptions[]
+
+function find(entries: readonly EntryOptions[], id: string): EntryOptions | undefined {
+  for (const entry of entries) {
+    if (entry.id === id) return entry
+    if (entry.group && Array.isArray(entry.config)) {
+      const nested = find(entry.config as EntryOptions[], id)
+      if (nested !== undefined) return nested
+    }
+  }
+  return undefined
+}
+
+describe('provider replacement in composed entry patches', () => {
+  it('preserves the actual base/web config and accepts later user overrides under the same id', () => {
+    const layers = [
+      ...load('../../../bundle/base/cordis.patch.yml'),
+      ...load('../../../bundle/web-app/cordis.patch.yml'),
+    ]
+    const warnings = vi.fn()
+    const before = applyEntryPatches([], layers, warnings)
+    const replacement = { id: 'session-query-sqlite', name: ORIGINAL, replaceName: REPLACEMENT }
+    const projected = applyEntryPatches([], [...layers, replacement], warnings)
+    expect(find(projected, replacement.id)).toEqual({ ...find(before, replacement.id), name: REPLACEMENT })
+    expect(find(projected, replacement.id)?.config).toEqual({ path: ':memory:', openAt: 'never' })
+    const config = { path: '/tmp/user-query.db', openAt: 'first-search', maxLimit: 17 }
+    const final = applyEntryPatches([], [...layers, replacement,
+      { id: replacement.id, config, disabled: true }], warnings)
+    expect(find(final, replacement.id)).toMatchObject({ id: replacement.id, name: REPLACEMENT, config, disabled: true })
+    expect(applyEntryPatches([], layers, warnings)).toEqual(before)
+    expect(warnings).not.toHaveBeenCalled()
+  })
+
+  it('retains the name guard and does not mutate its input or leak replaceName into an entry', () => {
+    const rows = [{ id: 'provider', name: ORIGINAL, config: { path: 'unchanged.db' }, disabled: true }]
+    const warnings = vi.fn()
+    const mismatch = applyEntryPatches(rows, [{ id: 'provider', name: 'wrong', replaceName: REPLACEMENT,
+      config: { path: 'wrong.db' }, disabled: false }], warnings)
+    expect(mismatch).toEqual(rows)
+    expect(warnings).toHaveBeenCalledOnce()
+    const replaced = applyEntryPatches(rows, [{ id: 'provider', name: ORIGINAL, replaceName: REPLACEMENT }], warnings)
+    expect(replaced).toEqual([{ ...rows[0], name: REPLACEMENT }])
+    expect(rows[0]?.name).toBe(ORIGINAL)
+    expect(replaced[0]).not.toHaveProperty('replaceName')
+    expect(applyEntryPatches(rows, [], warnings)).toEqual(rows)
+  })
+
+  it.each(['', '  ', null, false, 7, {}])('rejects malformed replaceName %j before applying other fields', (replaceName) => {
+    const rows = [{ id: 'provider', name: ORIGINAL, config: { path: 'unchanged.db' }, disabled: true }]
+    const warnings = vi.fn()
+    expect(applyEntryPatches(rows, [{ id: 'provider', replaceName: replaceName as unknown as string,
+      config: { path: 'wrong.db' }, disabled: false }], warnings)).toEqual(rows)
+    expect(warnings).toHaveBeenCalledOnce()
+  })
+
+  it('rejects replaceName mixed with insert before adding any entry', () => {
+    const warnings = vi.fn()
+    expect(applyEntryPatches([], [{ replaceName: REPLACEMENT, insert: [{ id: 'extra', name: ORIGINAL }] }], warnings)).toEqual([])
+    expect(warnings).toHaveBeenCalledOnce()
+  })
+
+  it('owns config overrides before later group insertion or caller mutation', () => {
+    const rows = [{ id: 'group', name: 'group', group: true, config: [] }]
+    const patches: PatchOptions[] = [
+      { id: 'group', config: [{ id: 'provider', name: ORIGINAL, config: { path: 'original.db' } }] },
+      { id: 'group', insert: [{ id: 'extra', name: 'extra' }] },
+    ]
+    const input = structuredClone({ rows, patches })
+    const warnings = vi.fn()
+    const composed = applyEntryPatches(rows, patches, warnings)
+    expect(composed[0]?.config).toHaveLength(2)
+    const providerConfig = find(composed, 'provider')?.config as { path: string }
+    providerConfig.path = 'mutated.db'
+    expect({ rows, patches }).toEqual(input)
+    const again = applyEntryPatches(rows, patches, warnings)
+    expect(again[0]?.config).toHaveLength(2)
+    expect(find(again, 'provider')?.config).toEqual({ path: 'original.db' })
+    expect(warnings).not.toHaveBeenCalled()
+  })
+})
