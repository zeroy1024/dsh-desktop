diff --git a/packages/client/ui-trajectory/tests/view-factory.client.spec.ts b/packages/client/ui-trajectory/tests/view-factory.client.spec.ts
new file mode 100644
index 0000000..6dfd568
--- /dev/null
+++ b/packages/client/ui-trajectory/tests/view-factory.client.spec.ts
@@ -0,0 +1,42 @@
+import type { Context } from '@deepseek-ai/cordis'
+import { expect, it, vi } from 'vitest'
+import { apply, type TrajectoryViewFactory } from '../src/client/index.ts'
+
+it('reuses native view data and restores exactly one native tab across takeover and unload', () => {
+  const effects: (() => void)[] = []
+  let factory: TrajectoryViewFactory | undefined
+  let declare: (() => (() => void)) | undefined
+  const entries = new Set<object>()
+  const register = vi.fn((options: object) => {
+    entries.add(options)
+    return () => { entries.delete(options) }
+  })
+  const context = {
+    effect: (fn: () => (() => void) | void) => { const off = fn(); if (off) effects.push(off) },
+    reflect: { provide: (_name: string, value: TrajectoryViewFactory) => { factory = value } },
+    locale: { register: () => {}, bind: () => (key: string) => key },
+    uiConversation: { events: { register: vi.fn() }, views: { register: vi.fn() } },
+    uiSession: { provide: vi.fn() },
+    slots: { register, inject: (_name: string, fn: () => (() => void)) => { declare = fn } },
+  } as unknown as Context
+  apply(context)
+  expect(entries.size).toBe(0)
+  factory!.setDefaultEnabled(false)
+  const offSlot = declare!()
+  expect(entries.size).toBe(0)
+  const contribution = factory!.create()
+  expect(contribution.options).toMatchObject({ id: 'trajectory', children: { 'conversation.trajectory.images': { scope: 'session' } } })
+  expect(typeof contribution.options.inject).toBe('function')
+  factory!.setDefaultEnabled(true)
+  factory!.setDefaultEnabled(true)
+  expect(entries.size).toBe(1)
+  expect(register).toHaveBeenCalledTimes(1)
+  factory!.setDefaultEnabled(false)
+  expect(entries.size).toBe(0)
+  factory!.setDefaultEnabled(true)
+  expect(entries.size).toBe(1)
+  offSlot()
+  for (const off of effects.toReversed()) off()
+  factory!.setDefaultEnabled(true)
+  expect(entries.size).toBe(0)
+})
