+/**
+ * Client-side visibility fold for rewind tombstones — the transcript-side
+ * counterpart of the core `dsh-desktop/session-rewind` surface fold. A
+ * tombstone at seq `T` carrying `atSeq: A` hides raw transcript events with
+ * seq in `[A, T)`; events appended after the marker (the re-asked turn) stay
+ * visible, and chained markers compose. Only the conversation view input is
+ * filtered — the raw window keeps every event so seq continuity, pagination
+ * cursors, and the live-append dedup guard keep operating on the untouched
+ * log.
+ *
+ * The literal below duplicates the core declaration
+ * (`packages/core/session/src/rewind.ts`) deliberately: importing the
+ * constant from the built `dsh-session` surface entry would couple this
+ * fold's resolution to that package's build freshness.
+ *
+ * @module @deepseek-ai/dsh-client-runtime/client/sessions/rewind
+ */
+
+import type { SessionEvent } from '@deepseek-ai/dsh-session/types'
+
+/** The rewind tombstone event type. Namespaced to the desktop harness owner. */
+export const REWIND_EVENT_TYPE = 'dsh-desktop/session-rewind'
+
+/** One tombstone's withdrawn range: raw events with seq in [atSeq, markerSeq). */
+export interface RewindRange {
+  readonly atSeq: number
+  readonly markerSeq: number
+}
+
+/** Collect every tombstone range declared inside a raw event window. */
+export function rewindRangesOf(events: readonly SessionEvent[]): RewindRange[] {
+  const ranges: RewindRange[] = []
+  for (const event of events) {
+    if (event.type === REWIND_EVENT_TYPE) {
+      ranges.push({ atSeq: (event.data as { atSeq: number }).atSeq, markerSeq: event.seq })
+    }
+  }
+  return ranges
+}
+
+/**
+ * Whether one event stays in the conversation view input: tombstones always
+ * flow through (a definition may claim one to render a rewind marker;
+ * unclaimed they are dropped by the fallback), every other event is hidden
+ * exactly when a tombstone's range covers it.
+ */
+export function keepViewEvent(event: SessionEvent, ranges: readonly RewindRange[]): boolean {
+  if (event.type === REWIND_EVENT_TYPE) return true
+  for (const range of ranges) {
+    if (event.seq >= range.atSeq && event.seq < range.markerSeq) return false
+  }
+  return true
+}
