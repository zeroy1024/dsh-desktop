diff --git a/packages/api/session-controller/tests/event-views.client.spec.ts b/packages/api/session-controller/tests/event-views.client.spec.ts
new file mode 100644
index 0000000..8adadef
--- /dev/null
+++ b/packages/api/session-controller/tests/event-views.client.spec.ts
@@ -0,0 +1,52 @@
+import { describe, expect, it, vi } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import { MutableSessionEventSource, type SessionEventLikeEntry, type SessionLiveEventEntry } from '../src/client/contract/events.ts'
+import { createSessionEventViewRegistry } from '../src/client/contract/event-views.ts'
+
+describe('Session event view contributions', () => {
+  it('updates existing and future binding identities, restores on unload, and disposes subscriptions', () => {
+    const registry = createSessionEventViewRegistry()
+    const raw = new MutableSessionEventSource()
+    const entry = { type: 'event', event: { seq: 0, type: 'user/message', time: 0, data: {} } } as unknown as SessionEventLikeEntry
+    raw.replace([entry], false)
+    const binding = registry.bind(raw, SessionId('a'))
+    const seen = vi.fn()
+    binding.source.subscribe(seen)
+    const before = binding.source.getSnapshot().revision
+    const dispose = vi.fn()
+    const unregister = registry.register(source => ({
+      source: { getSnapshot: () => ({ ...source.getSnapshot(), entries: [], change: { kind: 'replace', entries: [] } }), subscribe: listener => source.subscribe(listener) },
+      dispose,
+    }))
+    expect(binding.source.getSnapshot().entries).toEqual([])
+    expect(binding.source.getSnapshot().revision).toBeGreaterThan(before)
+    expect(seen).toHaveBeenCalledOnce()
+    const next = registry.bind(raw, SessionId('b'))
+    expect(next.source.getSnapshot().entries).toEqual([])
+    unregister()
+    expect(binding.source.getSnapshot().entries).toEqual([entry])
+    expect(next.source.getSnapshot().entries).toEqual([entry])
+    expect(dispose).toHaveBeenCalledTimes(2)
+    binding.dispose(); next.dispose()
+  })
+  it('releases a candidate whose subscription fails without losing the active source', () => {
+    const registry = createSessionEventViewRegistry()
+    const raw = new MutableSessionEventSource()
+    const binding = registry.bind(raw, SessionId('a'))
+    const disposed = vi.fn()
+    expect(() => registry.register(source => ({
+      source: {
+        getSnapshot: () => source.getSnapshot(),
+        subscribe: () => { throw new Error('subscription failed') },
+      },
+      dispose: disposed,
+    }))).toThrow('subscription failed')
+    expect(disposed).toHaveBeenCalledOnce()
+    const seen = vi.fn()
+    binding.source.subscribe(seen)
+    raw.append({ type: 'event', event: { seq: 1, type: 'test', time: 0, data: {} } } as unknown as SessionLiveEventEntry)
+    expect(seen).toHaveBeenCalledOnce()
+    binding.dispose()
+  })
+
+})
