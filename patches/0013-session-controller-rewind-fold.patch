+
+// ---------------------------------------------------------------------------
+// patches/0013 — rewind-visibility fold over the Conversation-facing feed.
+//
+// A tombstone event ('dsh-desktop/session-rewind', appended by the desktop
+// rewind plugin) hides the raw events with seq in [atSeq, markerSeq) from the
+// Conversation assembly. Only the assembled view is filtered: the raw window
+// keeps every event so seq continuity, pagination cursors, and the
+// live-append dedup guard keep operating on the untouched log. The marker
+// itself always flows through (a definition may claim it to render a rewind
+// marker; unclaimed it is dropped by the fallback).
+//
+// The literal below duplicates the core declaration
+// (packages/core/session/src/rewind.ts) deliberately: importing the constant
+// from the built dsh-session surface would couple this fold's resolution to
+// that package's build freshness.
+//
+
+/** The rewind tombstone event type. Namespaced to the desktop harness owner. */
+const REWIND_EVENT_TYPE = 'dsh-desktop/session-rewind'
+
+/** One tombstone's withdrawn range: raw events with seq in [atSeq, markerSeq). */
+export interface RewindRange {
+  readonly atSeq: number
+  readonly markerSeq: number
+}
+
+/** Unwrap a window entry ({ event }) or a bare event to its log face. */
+function logFaceOf(entry: unknown): { readonly seq: number; readonly type: string; readonly data?: unknown } {
+  const e = entry as { event?: { seq: number; type: string; data?: unknown }; seq?: number; type?: string; data?: unknown }
+  return e.event ?? (e as { seq: number; type: string; data?: unknown })
+}
+
+/** Collect every tombstone range declared inside a raw event window. */
+export function rewindRangesOf(events: readonly unknown[]): RewindRange[] {
+  const ranges: RewindRange[] = []
+  for (const entry of events) {
+    const event = logFaceOf(entry)
+    if (event.type === REWIND_EVENT_TYPE) {
+      ranges.push({ atSeq: (event.data as { atSeq: number }).atSeq, markerSeq: event.seq })
+    }
+  }
+  return ranges
+}
+
+/**
+ * Whether one event stays in the Conversation view input: tombstones always
+ * flow through (a definition may claim one to render a rewind marker),
+ * every other event is hidden exactly when a tombstone's range covers it.
+ */
+export function keepViewEvent(
+  entry: unknown,
+  ranges: readonly RewindRange[],
+): boolean {
+  const event = logFaceOf(entry)
+  if (event.type === REWIND_EVENT_TYPE) return true
+  for (const range of ranges) {
+    if (event.seq >= range.atSeq && event.seq < range.markerSeq) return false
+  }
+  return true
+}
+
+/**
+ * Wrap the raw event source with the rewind-visibility fold. The returned
+ * facade satisfies the MutableSessionEventSource surface Session and the
+ * bindings expose; every write routes to `raw`, and the published snapshot
+ * carries the folded view. A write whose tail entry is (or lands inside) a
+ * tombstone range republishes as a full window replacement so the
+ * assembler's incremental path rebuilds instead of appending a hidden row.
+ */
+export function createRewindVisibilitySource(raw: MutableSessionEventSource): SessionEventSource & { replace(entries: readonly SessionEventLikeEntry[], hasMore: boolean): void; prepend(entries: readonly SessionEventLikeEntry[], hasMore: boolean): void; append(entry: SessionLiveEventEntry): void } {
+  let listeners: Set<() => void> = new Set()
+  let published: SessionEventWindow | undefined
+
+  raw.subscribe(() => {
+    const rawWindow = raw.getSnapshot()
+    const change = rawWindow.change
+    // A write that carries (or follows) a tombstone rewrites visibility
+    // across the whole window: republish as a full replacement so the
+    // assembler's incremental path rebuilds instead of tripping over a
+    // hidden (withdrawn) materialized row.
+    const tombstone = change.entries.some(
+      entry => logFaceOf(entry).type === REWIND_EVENT_TYPE,
+    )
+    const ranges = rewindRangesOf(rawWindow.entries)
+    const entries = rawWindow.entries.filter(entry => keepViewEvent(entry.event, ranges))
+    published = {
+      entries,
+      hasMore: rawWindow.hasMore,
+      revision: rawWindow.revision,
+      change: tombstone ? { kind: 'replace', entries } : change,
+    }
+    for (const listener of [...listeners]) listener()
+  })
+
+  return {
+    getSnapshot: () => {
+      // Lazy self-heal for direct reads that skipped a notification: keep the
+      // last published window (its change semantics matter to the assembler)
+      // but refresh the folded entries and revision.
+      const rawWindow = raw.getSnapshot()
+      if (published === undefined || published.revision !== rawWindow.revision) {
+        const ranges = rewindRangesOf(rawWindow.entries)
+        published = {
+          entries: rawWindow.entries.filter(entry => keepViewEvent(entry.event, ranges)),
+          hasMore: rawWindow.hasMore,
+          revision: rawWindow.revision,
+          change: { kind: 'replace', entries: [] },
+        }
+      }
+      return published
+    },
+    subscribe: listener => {
+      listeners.add(listener)
+      return () => { listeners.delete(listener) }
+    },
+    replace: (entries, hasMore) => raw.replace(entries, hasMore),
+    prepend: (entries, hasMore) => raw.prepend(entries, hasMore),
+    append: entry => raw.append(entry),
+  }
+}
