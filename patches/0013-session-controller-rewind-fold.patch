diff --git a/packages/api/session-controller/tests/rewind-visibility.spec.ts b/packages/api/session-controller/tests/rewind-visibility.spec.ts
new file mode 100644
index 0000000000..c364f272fc
--- /dev/null
+++ b/packages/api/session-controller/tests/rewind-visibility.spec.ts
@@ -0,0 +1,74 @@
+/**
+ * Rewind-visibility fold (patches/0013): the Conversation-facing event source
+ * hides [atSeq, markerSeq) raw ranges, always flows the marker, and
+ * republishes a tombstone write as a full replacement.
+ */
+import { describe, expect, it } from 'vitest'
+import {
+  createRewindVisibilitySource,
+  keepViewEvent,
+  MutableSessionEventSource,
+  rewindRangesOf,
+  type SessionEventLikeEntry,
+} from '../src/client/sessions/session.ts'
+
+let nextSeq = 100
+function entry(type: string, data: Record<string, unknown> = {}): SessionEventLikeEntry {
+  const seq = nextSeq++
+  return { type: 'event' as const, event: { seq, time: seq, type, data } } as unknown as SessionEventLikeEntry
+}
+const user = () => entry('user/message', { content: [] })
+const marker = (atSeq: number) => entry('dsh-desktop/session-rewind', { atSeq })
+
+describe('rewindRangesOf / keepViewEvent', () => {
+  it('collects tombstone ranges and keeps the marker itself visible', () => {
+    const events = [user(), marker(100), user(), user()]
+    const ranges = rewindRangesOf(events)
+    expect(ranges).toEqual([{ atSeq: 100, markerSeq: events[1]!.event!.seq }])
+    expect(keepViewEvent(events[1]!, ranges)).toBe(true)
+    expect(keepViewEvent(events[0]!, ranges)).toBe(false)
+    expect(keepViewEvent(events[2]!, ranges)).toBe(true)
+    expect(keepViewEvent(events[3]!, ranges)).toBe(true)
+  })
+})
+
+describe('createRewindVisibilitySource', () => {
+  it('hides withdrawn ranges from the published window while keeping the raw log intact', () => {
+    const raw = new MutableSessionEventSource()
+    const source = createRewindVisibilitySource(raw)
+    const u1 = user()
+    const u2 = user()
+    raw.replace([u1, u2], false)
+    expect(source.getSnapshot().entries).toEqual([u1, u2])
+
+    const m = marker(0)
+    raw.append(m)
+    const window = source.getSnapshot()
+    expect(window.entries).toEqual([m])
+    expect(raw.getSnapshot().entries).toHaveLength(3)
+  })
+
+  it('republishes a tombstone append as a full replacement', () => {
+    const raw = new MutableSessionEventSource()
+    const source = createRewindVisibilitySource(raw)
+    raw.replace([user()], false)
+    const seen: string[] = []
+    source.subscribe(() => {
+      seen.push(source.getSnapshot().change.kind)
+    })
+    raw.append(marker(0))
+    expect(seen).toEqual(['replace'])
+  })
+
+  it('passes ordinary appends through as appends', () => {
+    const raw = new MutableSessionEventSource()
+    const source = createRewindVisibilitySource(raw)
+    raw.replace([user()], false)
+    const seen: string[] = []
+    source.subscribe(() => {
+      seen.push(source.getSnapshot().change.kind)
+    })
+    raw.append(user())
+    expect(seen).toEqual(['append'])
+  })
+})
