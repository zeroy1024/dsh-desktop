@@ -0,0 +1,112 @@
+/** Plugin-owned views over the read-only event feed; transport keeps the raw log. */
+import { notifySubscribers } from '@deepseek-ai/dsh-client-store'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { SessionEventSource, SessionEventWindow } from './events.ts'
+
+export interface SessionEventSourceView {
+  readonly source: SessionEventSource
+  dispose(): void
+}
+
+export type SessionEventSourceTransform = (source: SessionEventSource, sessionId: SessionId) => SessionEventSourceView
+
+export interface SessionEventViewRegistry {
+  /** Register in a plugin effect. Disposal restores every live binding's previous view. */
+  register(transform: SessionEventSourceTransform): () => void
+  /** Bind one source until its Session scope is disposed. */
+  bind(source: SessionEventSource, sessionId: SessionId): SessionEventSourceView
+}
+
+/** Stable binding identities and monotonic revisions across plugin load/unload. */
+export function createSessionEventViewRegistry(): SessionEventViewRegistry {
+  const transforms = new Set<SessionEventSourceTransform>()
+  const bindings = new Set<() => void>()
+  return {
+    register(transform) {
+      if (transforms.has(transform)) throw new Error('session event transform already registered')
+      transforms.add(transform)
+      try {
+        for (const rebind of bindings) rebind()
+      } catch (error) {
+        transforms.delete(transform)
+        for (const rebind of bindings) rebind()
+        throw error
+      }
+      let disposed = false
+      return () => {
+        if (disposed) return
+        disposed = true
+        transforms.delete(transform)
+        for (const rebind of bindings) rebind()
+      }
+    },
+    bind(raw, sessionId) {
+      const listeners = new Set<() => void>()
+      let revision = 0
+      let published: SessionEventWindow
+      let release = () => {}
+      const rebind = () => {
+        const views: SessionEventSourceView[] = []
+        let source = raw
+        let active = false
+        let unsubscribe = () => {}
+        let initial: SessionEventWindow
+        const publish = (replace: boolean, window = source.getSnapshot()) => {
+          revision += 1
+          published = {
+            // Do not materialize the whole rope on a streaming delta.
+            get entries() { return window.entries },
+            hasMore: window.hasMore,
+            revision,
+            change: replace
+              ? { kind: 'replace', get entries() { return window.entries } }
+              : window.change,
+          }
+          notifySubscribers(listeners, '[session-controller] event view')
+        }
+        try {
+          for (const transform of transforms) {
+            const view = transform(source, sessionId)
+            views.push(view)
+            source = view.source
+          }
+          // Prepare the complete candidate before releasing the active view.
+          // A provider may fail while subscribing or reading its first value.
+          unsubscribe = source.subscribe(() => { if (active) publish(false) })
+          initial = source.getSnapshot()
+        } catch (error) {
+          unsubscribe()
+          for (let i = views.length - 1; i >= 0; i--) views[i]?.dispose()
+          throw error
+        }
+        release()
+        active = true
+        release = () => {
+          active = false
+          unsubscribe()
+          for (let i = views.length - 1; i >= 0; i--) views[i]?.dispose()
+        }
+        publish(true, initial)
+      }
+      rebind()
+      bindings.add(rebind)
+      let disposed = false
+      return {
+        source: {
+          getSnapshot: () => published,
+          subscribe(listener) {
+            listeners.add(listener)
+            return () => { listeners.delete(listener) }
+          },
+        },
+        dispose() {
+          if (disposed) return
+          disposed = true
+          bindings.delete(rebind)
+          release()
+          listeners.clear()
+        },
+      }
+    },
+  }
+}
