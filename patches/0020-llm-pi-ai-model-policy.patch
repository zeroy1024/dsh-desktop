@@ -0,0 +1,57 @@
+import { describe, expect, it } from 'vitest'
+import { Config, resolveProfiles } from '../src/config.ts'
+import type { PiAiModelProfile } from '../src/config.ts'
+import { modelReasoningInfo, selectedThinking, thinkingPayload } from '../src/model-thinking.ts'
+import { catalogProvider } from '../src/catalog.ts'
+
+function resolve(models: PiAiModelProfile[], extra = {}) {
+  return resolveProfiles(Config({ providers: { self: {
+    api: 'openai-completions', baseURL: 'https://example.test/v1', models, ...extra,
+  } } }).providers).get('self')!
+}
+describe('model-owned policies on the native provider', () => {
+  it('does not materialize an opt-in policy or rewrite existing URLs', () => {
+    const raw = Config({ providers: { self: { api: 'anthropic-messages', baseURL: 'https://example.test/custom', models: [{ id: 'plain' }] } } })
+    expect(raw.providers!.self!.baseURLMode).toBeUndefined()
+    expect(raw.providers!.self!.models![0]!.thinking).toBeUndefined()
+    expect(resolveProfiles(raw.providers).get('self')!.piProvider.getModels()[0]!.baseUrl).toBe('https://example.test/custom')
+  })
+  it('resolves mixed APIs, opt-in roots and exact per-model URLs', () => {
+    const models = resolve([{ id: 'chat' }, { id: 'messages', api: 'anthropic-messages' }, { id: 'responses', api: 'openai-responses', baseURL: 'https://other.test/custom' }], { baseURLMode: 'api-root' }).piProvider.getModels()
+    expect(models.map(m => m.api)).toEqual(['openai-completions', 'anthropic-messages', 'openai-responses'])
+    expect(models.map(m => m.baseUrl)).toEqual(['https://example.test/v1', 'https://example.test', 'https://other.test/custom'])
+  })
+  it('retains catalog auth when overriding just one model protocol', () => {
+    const base = catalogProvider('openai')!
+    const id = base.getModels()[0]!.id
+    const profile = resolveProfiles(Config({ providers: { openai: { modelOverrides: { [id]: { api: 'anthropic-messages' } } } } }).providers).get('openai')!
+    expect(profile.piProvider.auth).toBe(base.auth)
+    expect(profile.piProvider.getModels().find(m => m.id === id)?.api).toBe('anthropic-messages')
+    expect(profile.piProvider.getModels().length).toBe(base.getModels().length)
+  })
+  it('validates capability defaults and filters incompatible provider defaults', () => {
+    const model = resolve([{ id: 'level', thinking: { mode: 'levels', levels: ['low', 'high'], default: 'low' } }]).piProvider.getModels()[0]!
+    expect(modelReasoningInfo(model, 'max').reasoning?.defaultEffort).toBe('low')
+    expect(selectedThinking(model, 'max', undefined)).toBe('low')
+    expect(() => selectedThinking(model, 'max', 'max')).toThrow()
+    expect(() => resolve([{ id: 'bad', thinking: { mode: 'levels', levels: ['high'], default: 'low' } }])).toThrow()
+    expect(() => resolve([{ id: 'bad', thinking: { mode: 'toggle' } }])).toThrow()
+    expect(() => resolve([{ id: 'bad', thinking: { mode: 'toggle', wire: 'anthropic-enabled' } }])).toThrow()
+    expect(() => resolve([{ id: 'bad', thinking: { mode: 'levels', levels: ['low', 'high'], wire: 'chat-thinking' } }])).toThrow()
+  })
+  it('represents toggle, fixed-on and non-thinking models without fake public levels', () => {
+    const models = resolve([
+      { id: 'toggle', thinking: { mode: 'toggle', wire: 'chat-thinking', default: 'on' } },
+      { id: 'fixed', thinking: { mode: 'always-on', wire: 'chat-thinking' } },
+      { id: 'none', thinking: { mode: 'none' } },
+    ]).piProvider.getModels()
