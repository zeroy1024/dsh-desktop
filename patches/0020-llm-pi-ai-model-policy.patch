diff --git a/packages/llm/llm-pi-ai/src/model-thinking.ts b/packages/llm/llm-pi-ai/src/model-thinking.ts
new file mode 100644
index 0000000..adc5fb0
--- /dev/null
+++ b/packages/llm/llm-pi-ai/src/model-thinking.ts
@@ -0,0 +1,87 @@
+/** Model-owned thinking policy. SDK level mapping stays private to dispatch. */
+import { getSupportedThinkingLevels } from '@earendil-works/pi-ai'
+import type { Api, Model, ModelThinkingLevel, ThinkingLevelMap } from '@earendil-works/pi-ai'
+import { LlmError, ReasoningEffortId } from '@deepseek-ai/dsh-llm'
+import type { LlmResolvedModelInfo } from '@deepseek-ai/dsh-llm'
+
+export const THINKING_EFFORTS = ['minimal', 'low', 'medium', 'high', 'xhigh', 'max'] as const
+export interface ModelThinking {
+  mode: 'inherit' | 'levels' | 'toggle' | 'always-on' | 'none'
+  levels?: (typeof THINKING_EFFORTS[number])[]
+  allowOff?: boolean
+  default?: (typeof THINKING_EFFORTS[number]) | 'on' | 'off'
+  wire?: 'native' | 'anthropic-adaptive' | 'anthropic-enabled' | 'chat-thinking'
+}
+type ConfiguredModel = Model<Api> & { harnessThinking?: ModelThinking }
+export function thinkingOf(model: Model<Api>): ModelThinking | undefined {
+  return (model as ConfiguredModel).harnessThinking
+}
+function choices(t: ModelThinking): string[] | undefined {
+  if (t.mode === 'none') return []
+  if (t.mode === 'toggle') return ['off', 'on']
+  if (t.mode === 'always-on') return ['on']
+  if (t.mode === 'levels') return [...t.allowOff ? ['off'] : [], ...t.levels ?? []]
+  return undefined
+}
+export function applyModelThinking(model: Model<Api>, policy: ModelThinking | undefined): Model<Api> {
+  if (policy === undefined) return model
+  const t = structuredClone(policy)
+  const fail = (message: string): never => { throw new Error(`llm-pi-ai: ${model.provider}/${model.id}: ${message}`) }
+  if (!['inherit', 'levels', 'toggle', 'always-on', 'none'].includes(t.mode)) fail('invalid thinking mode')
+  if (t.mode === 'levels' && (!t.levels?.length || new Set(t.levels).size !== t.levels.length || t.levels.some(l => !THINKING_EFFORTS.includes(l)))) fail('invalid thinking levels')
+  const wire = t.wire ?? 'native'
+  if (!['native', 'anthropic-adaptive', 'anthropic-enabled', 'chat-thinking'].includes(wire)) fail('invalid thinking wire')
+  if ((wire.startsWith('anthropic-') && model.api !== 'anthropic-messages') || (wire === 'chat-thinking' && model.api !== 'openai-completions')) fail('thinking wire does not match model API')
+  if ((t.mode === 'toggle' || t.mode === 'always-on') && wire === 'native') fail('toggle and always-on require an explicit wire preset')
+  if (t.mode === 'levels' && wire === 'anthropic-enabled') fail('budget-based levels must use native encoding')
+  if (t.mode === 'levels' && wire === 'chat-thinking') fail('binary chat-thinking wire cannot encode levels; use native encoding')
+  if ((t.mode === 'inherit' || t.mode === 'none') && wire !== 'native') fail('wire presets require an explicit thinking capability')
+  const declared = choices(t)
+  const supported = declared ?? getSupportedThinkingLevels(model)
+  if (t.default !== undefined && !supported.includes(t.default)) fail('thinking default is not supported')
+  let map = model.thinkingLevelMap
+  if (declared !== undefined) {
+    const sdkLevels = declared.map(x => x === 'on' ? 'high' : x)
+    map = Object.fromEntries(['off', ...THINKING_EFFORTS].map(level => [level,
+      sdkLevels.includes(level) ? model.thinkingLevelMap?.[level as ModelThinkingLevel] ?? (level === 'off' ? undefined : level) : null,
+    ])) as ThinkingLevelMap
+  }
+  return { ...model, reasoning: declared === undefined ? model.reasoning : declared.length > 0,
+    ...map === undefined ? {} : { thinkingLevelMap: map }, harnessThinking: t } as ConfiguredModel
+}
+export function modelReasoningInfo(model: Model<Api>, providerDefault: ModelThinkingLevel | undefined): Pick<LlmResolvedModelInfo, 'reasoning'> {
+  const t = thinkingOf(model)
+  const supported = t === undefined ? getSupportedThinkingLevels(model) : choices(t) ?? getSupportedThinkingLevels(model)
+  if (!model.reasoning || supported.length === 0) return {}
+  const defaultValue = t?.mode === 'always-on' ? 'on' : t?.default ?? (providerDefault !== undefined && supported.includes(providerDefault) ? providerDefault : undefined)
+  return { reasoning: {
+    efforts: supported.map(id => ({ id: ReasoningEffortId(id), name: id === 'on' ? t?.mode === 'always-on' ? 'Always on' : 'On' : id.charAt(0).toUpperCase() + id.slice(1) })),
+    ...defaultValue === undefined ? {} : { defaultEffort: ReasoningEffortId(defaultValue) },
+  } }
+}
+export function selectedThinking(model: Model<Api>, providerDefault: ModelThinkingLevel | undefined, explicit: string | undefined): string | undefined {
+  const info = modelReasoningInfo(model, providerDefault).reasoning
+  const selected = explicit ?? info?.defaultEffort
+  if (selected !== undefined && !info?.efforts.some(e => e.id === selected)) throw new LlmError(`Unsupported thinking selection ${selected} for ${model.id}`, 'UNSUPPORTED_REASONING_EFFORT')
+  return selected
+}
+/** No URL guessing on existing profiles: only the explicit api-root mode uses this. */
+export function apiRootURL(url: string, api: string): string {
+  if (!['anthropic-messages', 'openai-completions', 'openai-responses'].includes(api)) throw new Error(`api-root is unsupported for ${api}`)
+  const root = url.replace(/\/+$/, '').replace(/\/v1$/, '')
+  return api === 'anthropic-messages' ? root : `${root}/v1`
+}
+export function thinkingPayload(payload: unknown, model: Model<Api>, selected: string | undefined): unknown {
+  const t = thinkingOf(model)
+  const wire = t?.wire ?? 'native'
+  if (wire === 'native' || selected === undefined) return payload
+  if (!payload || typeof payload !== 'object' || Array.isArray(payload)) throw new Error('Invalid model request payload')
+  const body = { ...payload } as Record<string, unknown>
+  const enabled = selected !== 'off'
+  body.thinking = { type: enabled ? wire === 'anthropic-adaptive' ? 'adaptive' : 'enabled' : 'disabled' }
+  if (t?.mode !== 'levels') {
+    delete body.reasoning_effort
+    delete body.output_config
+  }
+  return body
+}
