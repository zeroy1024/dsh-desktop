diff --git a/packages/client/ui-workspace/src/client/row-actions.ts b/packages/client/ui-workspace/src/client/row-actions.ts
new file mode 100644
index 0000000..77b6d57
--- /dev/null
+++ b/packages/client/ui-workspace/src/client/row-actions.ts
@@ -0,0 +1,31 @@
+/** Additive per-session row actions; each plugin owns its callbacks and copy. */
+import type { ReactNode } from 'react'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+
+export interface SessionRowAction {
+  /** Namespaced action identity, distinct from native rename/fork/archive. */
+  id: string
+  label: string
+  icon: ReactNode
+  placement: 'menu' | 'inline'
+  run(): void
+}
+
+export type SessionRowActionFactory = (row: {
+  sessionId: SessionId
+  title: string
+  archive(): void
+}) => readonly SessionRowAction[]
+
+/** The registering plugin retains the returned disposer in its effect. */
+export function createSessionRowActions() {
+  const source = createSnapshotStore<readonly SessionRowActionFactory[]>([])
+  return {
+    source,
+    register(factory: SessionRowActionFactory): () => void {
+      source.set([...source.getSnapshot(), factory])
+      return () => { source.set(source.getSnapshot().filter(value => value !== factory)) }
+    },
+  }
+}
