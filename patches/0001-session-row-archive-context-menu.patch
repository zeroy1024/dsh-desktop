+/**
+ * Export one Session log as a Host-generated ZIP (patches/0001: session-row
+ * context-menu export). The page origin is the Host origin, so the relative
+ * URL reaches the same endpoint the Session Header's download capsule uses;
+ * the browser download manager owns progress and failures, so no dialog
+ * state rides along. Pure browser verb — no runtime service, hence local to
+ * the row instead of a prop-threaded callback.
+ */
+function downloadSessionLog(sessionId: SessionNode['id']): void {
+  const url = new URL('/api/session.export', window.location.origin)
+  url.searchParams.set('sessionId', sessionId)
+  url.searchParams.set('includeDescendants', 'true')
+  const anchor = document.createElement('a')
+  anchor.href = url.toString()
+  anchor.download = `dsh-session-${sessionId.replace(/[^A-Za-z0-9_-]/g, '_')}.zip`
+  anchor.click()
+}
