+describe('session row export menu item (patches/0001)', () => {
+  it('offers the session log export and navigates via a same-origin anchor', () => {
+    const node: SessionNode = {
+      id: sid('s1'), title: 'One', blank: false, running: false,
+      runningSubagentCount: 0, completed: false, hasActiveSchedule: false, updatedAt: 0,
+    }
+    const origCreate = document.createElement.bind(document)
+    const anchors: HTMLAnchorElement[] = []
+    vi.spyOn(document, 'createElement').mockImplementation(((tag: string, options?: ElementCreationOptions) => {
+      const el = origCreate(tag, options)
+      if (tag === 'a') anchors.push(el as HTMLAnchorElement)
+      return el
+    }) as typeof document.createElement)
+    render(<SessionNodeItem node={node} currentId={undefined} now={0} onOpen={vi.fn()}
+      onRename={vi.fn()} onFork={vi.fn()} onArchive={vi.fn()} t={t} />)
+    fireEvent.click(screen.getByRole('button', { name: '会话“One”的操作' }))
+    const item = screen.getByRole('menuitem', { name: '导出会话日志' })
+    fireEvent.click(item)
+    expect(anchors).toHaveLength(1)
+    expect(new URL(anchors[0]!.href).pathname + '?' + new URL(anchors[0]!.href).searchParams.toString()).toBe(
+      '/api/session.export?sessionId=s1&includeDescendants=true',
+    )
+    expect(anchors[0]!.download).toBe('dsh-session-s1.zip')
+  })
+})
