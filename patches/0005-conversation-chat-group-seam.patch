+  // process-only nodes fold behind one group): the real provider lives in
+  // ui-activity-group, which this package must not depend on.
+  const foldProcessRuns = (): ChatFlowGrouping => ({
+    group: (nodes) => {
+      const items: ChatFlowItem[] = []
+      let run: ChatNode[] = []
+      const flush = (): void => {
+        const head = run[0]
+        if (run.length >= 2 && head !== undefined) {
+          items.push({ kind: 'group', key: head.key, nodes: run })
+        }
+        else {
+          for (const node of run) items.push({ kind: 'node', key: node.key, node })
+        }
+        run = []
+      }
+      for (const node of nodes) {
+        const foldable = node.kind === 'tool-call'
+          || (node.kind === 'assistant-step'
+            && !node.data.blocks.some(block => block.kind === 'text'))
+        if (foldable) {
+          run.push(node)
+          continue
+        }
+        flush()
+        items.push({ kind: 'node', key: node.key, node })
+      }
+      flush()
+      return items
+    },
+  })
+  const thinkStep = (seq: number): AssistantMessageNode => ({
+    kind: 'assistant', seq, time: seq * 1_000, turn: 1, step: seq,
+    blocks: [{ kind: 'reasoning', text: `thinking ${seq}` }],
+  })
+
+  it('folds consecutive process nodes through the group slot with the first member as the anchor key', () => {
+    const h = makeHarness({
+      nodes: [
+        user(1, '任务'),
+        thinkStep(2),
+        toolResult(3, 'c1'),
+        toolResult(4, 'c2'),
+        assistant(5, '正文结论'),
+      ],
+    })
+    const view = render(<h.ChatView {...h.props} flowGrouping={foldProcessRuns} />)
+    // One group row replaces the three process rows; the wrapper carries the
+    // first member's key so scroll anchoring keeps addressing the group.
+    const groupRow = view.getByTestId('group-row')
+    expect(groupRow.getAttribute('data-group-head')).toBe('fixture:assistant:2')
+    const groupSeat = view.container.querySelector('[data-chat-flow-kind="activity-group"]')
+    expect(groupSeat?.getAttribute('data-chat-anchor-key')).toBe('fixture:assistant:2')
+    // Members are folded: no individual tool seats render, and the user
+    // bubble plus the prose answer stay on the flat flow.
+    expect(view.queryByTestId('tool-seat-c1')).toBeNull()
+    expect(view.queryByTestId('tool-seat-c2')).toBeNull()
+    expect(view.getByText('任务')).toBeTruthy()
+    expect(view.getByText('正文结论')).toBeTruthy()
+  })
+
+  it('renders the flattened transcript when no grouping service is present', () => {
+    const h = makeHarness({
+      nodes: [user(1, '任务'), thinkStep(2), toolResult(3, 'c1'), toolResult(4, 'c2')],
+    })
+    const view = render(<h.ChatView {...h.props} />)
+    expect(view.queryByTestId('group-row')).toBeNull()
+    expect(view.getByTestId('tool-seat-c1')).toBeTruthy()
+    expect(view.getByTestId('tool-seat-c2')).toBeTruthy()
+  })
+
+  it('regroups live as the flow structure changes', () => {
+    const h = makeHarness({ nodes: [user(1, '任务'), thinkStep(2)] })
+    const view = render(<h.ChatView {...h.props} flowGrouping={foldProcessRuns} />)
+    // A single process node stays flat: below the fold minimum.
+    expect(view.queryByTestId('group-row')).toBeNull()
+    expect(view.getByText('任务')).toBeTruthy()
+
+    act(() => {
+      h.set({ nodes: [user(1, '任务'), thinkStep(2), toolResult(3, 'c1'), toolResult(4, 'c2')] })
+    })
+    expect(view.getByTestId('group-row')).toBeTruthy()
+    expect(view.queryByTestId('tool-seat-c1')).toBeNull()
+  })
+})
