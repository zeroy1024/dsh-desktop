+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionStateMap { 'test/history': number[][] }
+}
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap { 'test/history': { read: boolean } }
+}
+
+async function harness() {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  return { ctx, session: ctx.sessions.create() }
+}
+
+function definition(read = (history: ProjectionEventHistory) => history().map(event => event.seq)) {
+  return {
+    key: 'test/history',
+    stateVersion: 1,
+    stateSchema: z.array(z.array(z.number())),
+    init: () => [],
+    apply: (state, event, history) => event.type === 'test/history' && event.data.read
+      ? [...state, read(history!)] : state,
+  } satisfies ProjectionDefinition<'test/history', number[][]>
+}
+
+const append = (session: Session, read: boolean) => session.append('test/history', { read })
+
+describe('lazy projection history', () => {
+  it('limits live, late-built and cached replay reads to the transition prefix', async () => {
+    const { ctx, session } = await harness()
+    const readers: ProjectionEventHistory[] = []
+    const release = ctx.sessionProjections.register(definition((history) => {
+      readers.push(history)
+      return history().map(event => event.seq)
+    }))
+    append(session, false)
+    append(session, true)
+    const before = ctx.sessionProjections.checkpoint(session)
+    append(session, false)
+    append(session, true)
+    const expected = [[0, 1], [0, 1, 2, 3]]
+    expect(ctx.sessionProjections.checkpoint(session)['test/history']?.val).toEqual(expected)
+    // A stored reader still describes the event it was passed with, even as
+    // the Session receives later events.
+    expect(readers.map(read => read().map(event => event.seq))).toEqual(expected)
+    const restored = ctx.sessionProjections.restore(before, session.snapshotEvents(),
+      SessionLogOffset(0), session.header, session.inheritedEventCount)
+    expect(restored.checkpoint['test/history']?.val).toEqual(expected)
+    release()
+    ctx.sessionProjections.register(definition())
+    expect(ctx.sessionProjections.checkpoint(session)['test/history']?.val).toEqual(expected)
+    const replay = ctx.sessionProjections.restore({}, session.snapshotEvents(),
+      SessionLogOffset(0), session.header, session.inheritedEventCount)
+    expect(replay.checkpoint['test/history']?.val).toEqual(expected)
+  })
+
+  it('does not materialize the log for ordinary live deltas', async () => {
+    const { ctx, session } = await harness()
+    ctx.sessionProjections.register(definition())
+    ctx.sessionProjections.snapshot(session)
+    const snapshots = vi.spyOn(session, 'snapshotEvents')
+    for (let index = 0; index < 1000; index++) append(session, false)
+    expect(snapshots).not.toHaveBeenCalled()
+    append(session, true)
+    expect(snapshots).toHaveBeenCalledExactlyOnceWith(SessionLogOffset(0), SessionLogOffset(1001))
+  })
+
+  it('requires a complete prefix only when a suffix replay actually reads history', async () => {
+    const { ctx, session } = await harness()
+    ctx.sessionProjections.register(definition())
+    append(session, false)
+    append(session, false)
+    const before = ctx.sessionProjections.checkpoint(session)
+    append(session, false)
+    const restore = () => ctx.sessionProjections.restore(before,
+      session.snapshotEvents(SessionLogOffset(1)), SessionLogOffset(1), session.header, session.inheritedEventCount)
+    expect(restore().checkpoint['test/history']?.val).toEqual([])
+    append(session, true)
+    expect(restore).toThrow(/requires history before seq 1; re-read from seq 0/)
+  })
+})
