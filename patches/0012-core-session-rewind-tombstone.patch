diff --git a/packages/core/session/tests/rewind.spec.ts b/packages/core/session/tests/rewind.spec.ts
new file mode 100644
index 0000000000..743c2816fe
--- /dev/null
+++ b/packages/core/session/tests/rewind.spec.ts
@@ -0,0 +1,213 @@
+import { describe, expect, it } from 'vitest'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { Session, SessionId, foldSurface } from '@deepseek-ai/dsh-session'
+import { SurfaceManager } from '@deepseek-ai/dsh-session/surface'
+import { createMessage, createUserMessage } from '@deepseek-ai/dsh-llm'
+import { REWIND_EVENT_TYPE } from '../src/rewind.ts'
+import { KNOWN_SESSION_EVENT_TYPES } from '../src/known-event-types.ts'
+
+/** Append one completed turn (user + assistant) and return the user event seq. */
+function appendTurn(session: Session, turn: number, text: string): number {
+  session.append('turn/start', { turn })
+  const user = session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text }],
+    source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+  session.append('assistant/message', {
+    turn,
+    step: 1,
+    message: createMessage({
+      role: 'assistant',
+      content: [{ type: 'text', text: `answer ${turn}` }],
+      source: { kind: 'model', ...{ provider: 'mock', model: 'mock' } },
+    }),
+  }, { surfaceOp: 'append' })
+  session.append('turn/end', { turn, reason: { kind: 'completed' } })
+  return user.seq
+}
+
+/** Bare log-event builders for direct foldSurface/SurfaceManager assertions. */
+const at = (seq: number, event: Record<string, unknown>): SessionEvent =>
+  ({ seq, time: 1_700_000_000_000 + seq, ...event }) as unknown as SessionEvent
+
+const turnStart = (seq: number, turn: number): SessionEvent =>
+  at(seq, { type: 'turn/start', data: { turn } })
+
+const turnEnd = (seq: number, turn: number): SessionEvent =>
+  at(seq, { type: 'turn/end', data: { turn, reason: { kind: 'completed' } } })
+
+const userEvent = (seq: number): SessionEvent =>
+  at(seq, { type: 'user/message', surfaceOp: 'append', data: createUserMessage({
+    content: [{ type: 'text', text: `q${seq}` }],
+    source: { kind: 'user' },
+  }) })
+
+const assistantEvent = (seq: number): SessionEvent =>
+  at(seq, { type: 'assistant/message', surfaceOp: 'append', data: {
+    turn: 1,
+    step: 1,
+    message: createMessage({
+      role: 'assistant',
+      content: [{ type: 'text', text: `a${seq}` }],
+      source: { kind: 'model', ...{ provider: 'mock', model: 'mock' } },
+    }),
+  } })
+
+/** A session with two completed turns; the rewind targets land inside turn 2. */
+function twoTurnSession(): { session: Session; firstUserSeq: number; secondUserSeq: number } {
+  const session = Session.create(SessionId('rewind'))
+  const firstUserSeq = appendTurn(session, 1, 'first')
+  const secondUserSeq = appendTurn(session, 2, 'second')
+  return { session, firstUserSeq, secondUserSeq }
+}
+
+describe('rewind tombstone surface fold', () => {
+  it('withdraws the [atSeq, marker) range while post-rewind appends stay visible', () => {
+    const { session, secondUserSeq } = twoTurnSession()
+    // Layout: turn1 = seq 0..3 (user 1, assistant 2), turn2 = seq 4..7 (user 5, assistant 6).
+    expect(secondUserSeq).toBe(5)
+    const marker = session.append(REWIND_EVENT_TYPE, { atSeq: secondUserSeq })
+    expect(marker.seq).toBe(8)
+    appendTurn(session, 3, 'retry')
+
+    // [5, 8) withdrawn: turn 2's messages leave the surface, turn 3 (seq 9..12
+    // rebuilt from the marker) stays visible alongside the turn 1 prefix.
+    expect(foldSurface(session.events).nodes).toEqual([1, 2, 10, 11])
+  })
+
+  it('keeps the incremental SurfaceManager replay equal to the full fold', () => {
+    const { session, secondUserSeq } = twoTurnSession()
+    session.append(REWIND_EVENT_TYPE, { atSeq: secondUserSeq })
+    appendTurn(session, 3, 'retry')
+    session.append(REWIND_EVENT_TYPE, { atSeq: 0 })
+
+    const full = foldSurface(session.events)
+    const incremental = new SurfaceManager(session.events)
+    expect(incremental.nodes).toEqual(full.nodes)
+    expect(incremental.nodes).toEqual([])
+    expect(incremental.replaceGeneration).toBe(2)
+  })
+
+  it('drops withdrawn messages from deriveMessages and invalidates the incremental cache', () => {
+    const { session, secondUserSeq } = twoTurnSession()
+    expect(session.deriveMessages()).toHaveLength(4)
+    // Warm the incremental cache so the truncation must force a rebuild.
+    expect(session.deriveMessages()).toHaveLength(4)
+
+    session.append(REWIND_EVENT_TYPE, { atSeq: secondUserSeq })
+    expect(session.deriveMessages()).toHaveLength(2)
+    expect(session.deriveMessages()[0]?.content).toEqual([{ type: 'text', text: 'first' }])
+
+    appendTurn(session, 3, 'retry')
+    const messages = session.deriveMessages()
+    expect(messages).toHaveLength(4)
+    expect(messages[2]?.content).toEqual([{ type: 'text', text: 'retry' }])
+    expect(messages.at(-1)?.content).toEqual([{ type: 'text', text: 'answer 3' }])
+  })
+
+  it('composes chained tombstones reaching further back', () => {
+    const { session, firstUserSeq, secondUserSeq } = twoTurnSession()
+    session.append(REWIND_EVENT_TYPE, { atSeq: secondUserSeq })
+    appendTurn(session, 3, 'retry')
+    // Second rewind withdraws everything from the first turn's user message.
+    session.append(REWIND_EVENT_TYPE, { atSeq: firstUserSeq })
+    expect(session.deriveMessages()).toHaveLength(0)
+  })
+
+  it('rejects malformed markers at append and seed boundaries', () => {
+    const { session, secondUserSeq } = twoTurnSession()
+    expect(() => session.append(REWIND_EVENT_TYPE, { atSeq: secondUserSeq + 999 }))
+      .toThrow(/invalid atSeq/)
+    expect(() => session.append(REWIND_EVENT_TYPE, { atSeq: -1 }))
+      .toThrow(/invalid atSeq/)
+    expect(() => session.append(REWIND_EVENT_TYPE, { atSeq: 1.5 }))
+      .toThrow(/invalid atSeq/)
+
+    const good = twoTurnSession()
+    const marker = good.session.append(REWIND_EVENT_TYPE, { atSeq: good.secondUserSeq })
+    // Contiguous seq but an atSeq beyond the marker: the seed's surface
+    // validation must reject the malformed marker itself.
+    const seed = [...good.session.events, { ...marker, seq: marker.seq + 1, data: { atSeq: marker.seq + 999 } } as SessionEvent]
+    expect(() => Session.create(SessionId('rewind-seed'), seed)).toThrow(/invalid seed event/)
+  })
+
+  it('reconstructs the truncated surface from a seed replay', () => {
+    const { session, secondUserSeq } = twoTurnSession()
+    session.append(REWIND_EVENT_TYPE, { atSeq: secondUserSeq })
+    const markerSeq = session.events.at(-1)!.seq
+    appendTurn(session, 3, 'retry')
+
+    const replayed = Session.create(SessionId('rewind-replay'), session.events)
+    expect(replayed.deriveMessages()).toHaveLength(4)
+    expect(replayed.events.at(-1)!.seq).toBeGreaterThan(markerSeq)
+  })
+
+  it('catalogues the tombstone type so persistence reads accept it', () => {
+    expect(KNOWN_SESSION_EVENT_TYPES.has(REWIND_EVENT_TYPE)).toBe(true)
+  })
+
+  it('keeps the incremental fold equal to the full fold across a compaction replacement', () => {
+    // Layout: turn1 user 1 / assistant 2, turn2 user 5 / assistant 6, compaction
+    // checkpoint at seq 8 replaces [5, 6], post-checkpoint user 10 / assistant 11,
+    // rewind marker at seq 12 withdraws [10, 12) — the checkpoint itself survives.
+    const events = [
+      turnStart(0, 1), userEvent(1), assistantEvent(2), turnEnd(3, 1),
+      turnStart(4, 2), userEvent(5), assistantEvent(6), turnEnd(7, 2),
+      {
+        seq: 8,
+        time: 1_700_000_000_008,
+        type: 'user/message',
+        surfaceOp: { op: 'replace', start: 5, end: 6 },
+        sourceEventSeqs: [5, 6],
+        data: { content: [{ type: 'text', text: 'checkpoint' }], source: { kind: 'user' } },
+      } as unknown as SessionEvent,
+      turnStart(9, 3), userEvent(10), assistantEvent(11), turnEnd(12, 3),
+      { seq: 13, time: 1_700_000_000_013, type: REWIND_EVENT_TYPE, data: { atSeq: 10 } } as unknown as SessionEvent,
+    ]
+    const full = foldSurface(events)
+    expect(full.nodes).toEqual([1, 2, 8])
+    expect(new SurfaceManager(events).nodes).toEqual(full.nodes)
+    expect(new SurfaceManager(events).replaceGeneration).toBe(2)
+  })
+
+  it('folds by log seq when the marker lands inside a replaced (shadowed) range', () => {
+    // The host precheck refuses this shape; the fold documents what would happen
+    // if it slipped through: the checkpoint node (seq 8 >= atSeq 6) is withdrawn
+    // together with the shadowed range — the "over-rewind" the precheck exists for.
+    const events = [
+      turnStart(0, 1), userEvent(1), assistantEvent(2), turnEnd(3, 1),
+      turnStart(4, 2), userEvent(5), assistantEvent(6), turnEnd(7, 2),
+      {
+        seq: 8,
+        time: 1_700_000_000_008,
+        type: 'user/message',
+        surfaceOp: { op: 'replace', start: 5, end: 6 },
+        sourceEventSeqs: [5, 6],
+        data: { content: [{ type: 'text', text: 'checkpoint' }], source: { kind: 'user' } },
+      } as unknown as SessionEvent,
+      { seq: 9, time: 1_700_000_000_009, type: REWIND_EVENT_TYPE, data: { atSeq: 6 } } as unknown as SessionEvent,
+    ]
+    // nodes [1, 2, 8] truncated at 6 drops the checkpoint: [1, 2] remain.
+    expect(foldSurface(events).nodes).toEqual([1, 2])
+    expect(new SurfaceManager(events).nodes).toEqual([1, 2])
+  })
+
+  it('withdraws everything down to the start with chained markers around a replacement', () => {
+    const events = [
+      turnStart(0, 1), userEvent(1), assistantEvent(2), turnEnd(3, 1),
+      turnStart(4, 2), userEvent(5), assistantEvent(6), turnEnd(7, 2),
+      {
+        seq: 8,
+        time: 1_700_000_000_008,
+        type: 'user/message',
+        surfaceOp: { op: 'replace', start: 5, end: 6 },
+        sourceEventSeqs: [5, 6],
+        data: { content: [{ type: 'text', text: 'checkpoint' }], source: { kind: 'user' } },
+      } as unknown as SessionEvent,
+      { seq: 9, time: 1_700_000_000_009, type: REWIND_EVENT_TYPE, data: { atSeq: 5 } } as unknown as SessionEvent,
+      { seq: 10, time: 1_700_000_000_010, type: REWIND_EVENT_TYPE, data: { atSeq: 0 } } as unknown as SessionEvent,
+    ]
+    expect(foldSurface(events).nodes).toEqual([])
+    expect(new SurfaceManager(events).nodes).toEqual([])
+  })
+})
