+/**
+ * Validate a rewind tombstone at its replay boundary into a truncate
+ * transition. A tombstone withdraws every surface node with `seq` in
+ * `[atSeq, event.seq)`; events appended after the marker rebuild the surface
+ * from there. An `atSeq` above the marker's own position would hide nothing
+ * and is rejected as a malformed marker.
+ */
+function planRewindEvent(event: SessionEvent): SurfacePlan | undefined {
+  if (event.type !== REWIND_EVENT_TYPE) return undefined
+  const atSeq = event.data.atSeq
+  if (!isEventSeq(atSeq) || atSeq > event.seq) {
+    throw new Error(`rewind tombstone at seq ${event.seq} carries invalid atSeq ${String(atSeq)}`)
+  }
+  return { kind: 'truncate', atSeq }
+}
