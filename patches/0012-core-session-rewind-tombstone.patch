+++ b/packages/llm/token-meter/tests/rewind.spec.ts
@@ -0,0 +1,161 @@
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { CompactionId } from '@deepseek-ai/dsh-compaction'
+import { createMessage, createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { deriveEventMessage, SessionLogOffset } from '@deepseek-ai/dsh-session'
+import type { EpochHeader, Session, SessionSeq } from '@deepseek-ai/dsh-session'
+import { REWIND_EVENT_TYPE } from '@deepseek-ai/dsh-session/surface'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import type { ProjectionCheckpoint } from '@deepseek-ai/dsh-session-projection'
+import TokenMeter from '@deepseek-ai/dsh-token-meter'
+import { estimateHeader } from '../src/estimate.ts'
+
+const HEADER: EpochHeader = { config: { provider: 'mock', model: 'mock' }, system: 'system' }
+
+async function harness() {
+  const ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(TokenMeter)
+  return { ctx, session: ctx.sessions.create() }
+}
+
+function turn(session: Session, number: number, text: string, inputTokens?: number): SessionSeq {
+  session.append('turn/start', { turn: number })
+  const prompt = session.append('user/message', createUserMessage({
+    content: [{ type: 'text', text }], source: { kind: 'user' },
+  }), { surfaceOp: 'append' })
+  session.append('step/start', { turn: number, step: 1 })
+  session.append('request/header', { header: HEADER, reason: 'initial' })
+  session.append('request/context', { provider: 'mock', model: 'mock', contextWindow: 1000 })
+  session.append('assistant/message', {
+    turn: number, step: 1,
+    message: createMessage({ role: 'assistant', content: [{ type: 'text', text: 'answer' }],
+      source: { kind: 'model', provider: 'mock', model: 'mock' } }),
+    ...inputTokens === undefined ? {} : { usage: { inputTokens, outputTokens: 10 } },
+  }, { surfaceOp: 'append' })
+  session.append('step/end', { turn: number, step: 1 })
+  session.append('turn/end', { turn: number, reason: { kind: 'completed' } })
+  return prompt.seq
+}
+
+function restore(ctx: Context, session: Session, checkpoint: ProjectionCheckpoint = {}) {
+  return ctx.sessionProjections.restore(checkpoint, session.snapshotEvents(), SessionLogOffset(0),
+    session.header, session.inheritedEventCount)
+}
+
+function expectRetainedSurface(ctx: Context, session: Session) {
+  const measured = ctx.tokenMeter.measure(session)
+  expect(measured.nodes.map(node => node.seq)).toEqual(session.surface.nodes)
+  const heuristicTokens = session.surface.nodes.reduce((total, seq) => {
+    const message = deriveEventMessage(session.eventAt(seq)!)
+    return total + (message === null ? 0 : ctx.tokenMeter.estimateMessage(message))
+  }, 0)
+  const snapshot = ctx.sessionProjections.snapshot(session)
+  expect(snapshot.values.contextBreakdown?.messageTokens).toBe(heuristicTokens)
+  expect(restore(ctx, session).snapshot).toEqual(snapshot)
+  return { measured, snapshot }
+}
+
+describe('rewind token accounting', () => {
+  it('reprices the retained context, clears discarded calibration, and keeps cumulative billing', async () => {
+    const { ctx, session } = await harness()
+    const first = turn(session, 1, 'keep', 100)
+    const second = turn(session, 2, 'remove '.repeat(700), 4000)
+    expect(ctx.tokenMeter.measure(session).totalTokens).toBeGreaterThan(1000)
+    const billed = ctx.sessionProjections.snapshot(session).values.tokenUsage
+    const checkpoint = ctx.sessionProjections.checkpoint(session)
+
+    // Existing persisted tombstones contain only atSeq, with no token receipt.
+    session.append(REWIND_EVENT_TYPE, { atSeq: second })
+    const { measured, snapshot } = expectRetainedSurface(ctx, session)
+    expect(measured.baseline.kind).toBe('estimated')
+    expect(measured.totalTokens).toBe(measured.surfaceTokens + estimateHeader(HEADER))
+    expect(measured.totalTokens).toBeLessThan(1000)
+    expect(snapshot.values.contextPressure).toEqual({ contextWindow: 1000, projectedTokens: measured.totalTokens })
+    expect(snapshot.values.tokenUsage).toEqual(billed)
+    expect(restore(ctx, session, checkpoint).snapshot).toEqual(snapshot)
+
+    // A new call restores provider calibration, and a second rewind removes
+    // both the old branch and its replacement without resurrecting either.
+    turn(session, 3, 'retry', 300)
+    expect(ctx.tokenMeter.measure(session).baseline.kind).toBe('usage')
+    expectRetainedSurface(ctx, session)
+    session.append(REWIND_EVENT_TYPE, { atSeq: first })
+    expectRetainedSurface(ctx, session)
+    expect(ctx.tokenMeter.measure(session).nodes).toEqual([])
+    expect(ctx.sessionProjections.snapshot(session).values.tokenUsage?.uncachedInputTokens).toBe(4400)
+
+    // A newly created service must agree with the eagerly updated one.
+    const cold = new Context()
+    new SessionProjectionRegistry(cold)
+    const coldMeter = new TokenMeter(cold)
+    expect(coldMeter.measure(session)).toEqual(ctx.tokenMeter.measure(session))
+  })
+
+  it('keeps calibration from a retained request when only later input is discarded', async () => {
+    const { ctx, session } = await harness()
+    turn(session, 1, 'keep', 100)
+    const before = ctx.tokenMeter.measure(session)
+    const pressure = ctx.sessionProjections.snapshot(session).values.contextPressure
+    const later = session.append('user/message', createUserMessage({
+      content: [{ type: 'text', text: 'pending '.repeat(100) }], source: { kind: 'user' },
+    }), { surfaceOp: 'append' })
+    ctx.tokenMeter.measure(session)
+    session.append(REWIND_EVENT_TYPE, { atSeq: later.seq })
+    const { measured, snapshot } = expectRetainedSurface(ctx, session)
+    expect(measured.baseline).toEqual(before.baseline)
+    expect(measured.totalTokens).toBe(before.totalTokens)
+    expect(snapshot.values.contextPressure).toEqual(pressure)
+  })
+
+  it('rejects old price caches and does not include future retries in a replayed rewind prefix', async () => {
+    const { ctx, session } = await harness()
+    turn(session, 1, 'keep', 100)
+    const cut = turn(session, 2, 'remove '.repeat(300), 2000)
+    const checkpoint = ctx.sessionProjections.checkpoint(session)
+    session.append(REWIND_EVENT_TYPE, { atSeq: cut })
+    turn(session, 3, 'new '.repeat(100), 1000)
+    const { snapshot } = expectRetainedSurface(ctx, session)
+    expect(restore(ctx, session, checkpoint).snapshot).toEqual(snapshot)
+    // A legacy reader could have checkpointed at the tombstone while still
+    // counting its withdrawn surface. Versions must force a complete replay.
+    const stale = ctx.sessionProjections.checkpoint(session)
+    stale.contextPressure = { ver: 4, seq: stale.contextPressure!.seq, val: { surfaceTokens: 999999 } }
+    stale.contextBreakdown = { ver: 2, seq: stale.contextBreakdown!.seq,
+      val: { messageTokens: 999999, systemTokens: 999999, toolsTokens: 0 } }
+    const recovered = restore(ctx, session, stale)
+    expect(recovered.snapshot).toEqual(snapshot)
+    expect(recovered.checkpoint.contextPressure?.ver).toBe(5)
+    expect(recovered.checkpoint.contextBreakdown?.ver).toBe(3)
+  })
+
+  it('folds metered compaction before and after a rewind against the same core surface', async () => {
+    const { ctx, session } = await harness()
+    turn(session, 1, 'large first '.repeat(100))
+    const replace = () => {
+      const nodes = ctx.tokenMeter.measure(session).nodes
+      const start = nodes[0]!.seq
+      const end = nodes[1]!.seq
+      session.append('compaction/summary', {
+        compactionId: CompactionId('rewind-price'), summary: [{ type: 'text', text: 'summary' }],
+        shadowedRange: { start, end }, shadowedSeqs: [start, end],
+        shadowedTokenCount: nodes.slice(0, 2).reduce((sum, node) => sum + node.heuristicTokens, 0),
+        provider: 'mock', model: 'mock',
+      })
+      session.append('user/message', createUserMessage({ content: [{ type: 'text', text: 'summary' }],
+        source: { kind: 'plugin', plugin: 'compaction-basic' } }), {
+        surfaceOp: { op: 'replace', start, end }, sourceEventSeqs: [start, end],
+      })
+    }
+    replace()
+    const cut = turn(session, 2, 'discard '.repeat(100), 3000)
+    ctx.tokenMeter.measure(session)
+    session.append(REWIND_EVENT_TYPE, { atSeq: cut })
+    expectRetainedSurface(ctx, session)
+    expect(ctx.tokenMeter.measure(session).nodes).toHaveLength(1)
+    turn(session, 3, 'retry '.repeat(100))
+    replace()
+    expectRetainedSurface(ctx, session)
+  })
+})
