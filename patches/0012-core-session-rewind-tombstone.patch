@@ -0,0 +1,31 @@
+/**
+ * Desktop-harness rewind tombstone. `dsh-desktop/session-rewind` is an
+ * append-only marker that withdraws every model-visible surface node with
+ * `seq` in `[atSeq, markerSeq)` at the marker's log position; events appended
+ * after the marker rebuild the surface from there. The raw log keeps the
+ * withdrawn events forever — the tombstone only changes what every surface
+ * fold derives, which is why skipping it on replay would reconstruct a wrong
+ * session (the reason the type is catalogued below instead of `ignorable`).
+ *
+ * Patch-owned addition (deepseek-harness-desktop `patches/0012`); the
+ * declaration lives in this package so the persistence catalog generator
+ * (`scripts/gen-persistence-catalog.ts`) lists the type and the persistence
+ * read path accepts logs carrying it. The upstream-fold integration is in
+ * `./surface.ts` (`planRewindEvent` / the `truncate` plan variant).
+ *
+ * @module @deepseek-ai/dsh-session/rewind
+ */
+
+/** The tombstone event type. Namespaced to the desktop harness owner. */
+export const REWIND_EVENT_TYPE = 'dsh-desktop/session-rewind'
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /**
+     * Rewind tombstone: withdraws surface nodes with `seq` in
+     * `[atSeq, seq)`. `atSeq` must be a non-negative safe integer addressing
+     * a position at or before the marker itself.
+     */
+    'dsh-desktop/session-rewind': { atSeq: number }
+  }
+}
