 /** Conversation message event types (the pagination counting unit). */
 const MESSAGE_TYPES = new Set(['user/message', 'assistant/message'])
+
+type ImageInputCapability = 'native' | 'text-only' | 'unknown'
+type ImageInputAdmissionResolution = 'resolved' | 'failed'
+type ImageInputAdmission = 'bridge' | 'abstain'
+
+interface ImageInputAdmissionService {
+  admit(request: {
+    provider: string
+    model: string
+    capability: ImageInputCapability
+    resolution: ImageInputAdmissionResolution
+  }): ImageInputAdmission | Promise<ImageInputAdmission>
+}
+
+/**
+ * Keep native model facts separate from plugin-provided image conversion.
+ * Unknown metadata retains DSH's adapter-owned pass-through semantics unless
+ * an optional admission service explicitly owns the conversion.
+ */
+async function imagePromptAdmission(
+  ctx: Context,
+  provider: string,
+  model: string,
+): Promise<boolean> {
+  const service = ctx.get('imageInputAdmission') as ImageInputAdmissionService | undefined
+  const admit = async (
+    capability: ImageInputCapability,
+    resolution: ImageInputAdmissionResolution,
+  ): Promise<ImageInputAdmission> => {
+    if (typeof service?.admit !== 'function') return 'abstain'
+    return await service.admit({ provider, model, capability, resolution }) === 'bridge'
+      ? 'bridge'
+      : 'abstain'
+  }
 
+  let capability: ImageInputCapability
+  try {
+    const inputModalities = (await ctx.llm.resolveModelInfo(provider, model)).inputModalities
+    capability = inputModalities === undefined
+      ? 'unknown'
+      : inputModalities.includes('image') ? 'native' : 'text-only'
+  } catch (error: unknown) {
+    if (await admit('unknown', 'failed') === 'bridge') return true
+    throw error
+  }
+  if (capability === 'native') return true
+  if (await admit(capability, 'resolved') === 'bridge') return true
+  return capability === 'unknown'
+}
