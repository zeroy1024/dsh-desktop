diff --git a/packages/api/session-controller/tests/image-admission.spec.ts b/packages/api/session-controller/tests/image-admission.spec.ts
new file mode 100644
index 0000000000..f5483edb1f
--- /dev/null
+++ b/packages/api/session-controller/tests/image-admission.spec.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it, vi } from 'vitest'
+import { imagePromptAdmission } from '../src/commands.ts'
+
+const provider = 'p'
+const model = 'm'
+const resolver = (inputModalities?: readonly string[]) => async () => ({ inputModalities })
+
+describe('imagePromptAdmission (patches/0010)', () => {
+  it('admits natively without consulting the service', async () => {
+    const service = { admit: vi.fn() }
+    await expect(imagePromptAdmission(service, resolver(['image']), provider, model)).resolves.toBe(true)
+    expect(service.admit).not.toHaveBeenCalled()
+  })
+
+  it('lets an absent service keep the text-only rejection', async () => {
+    await expect(imagePromptAdmission(undefined, resolver(['text']), provider, model)).resolves.toBe(false)
+  })
+
+  it('admits a text-only model when the service bridges it, and rejects on abstain', async () => {
+    const bridging = { admit: vi.fn(async () => 'bridge' as const) }
+    await expect(imagePromptAdmission(bridging, resolver(['text']), provider, model)).resolves.toBe(true)
+    expect(bridging.admit).toHaveBeenCalledWith({ provider, model, capability: 'text-only', resolution: 'resolved' })
+    const abstaining = { admit: vi.fn(async () => 'abstain' as const) }
+    await expect(imagePromptAdmission(abstaining, resolver(['text']), provider, model)).resolves.toBe(false)
+  })
+
+  it('treats unknown metadata as non-native and consults the service once resolved', async () => {
+    const service = { admit: vi.fn(async () => 'bridge' as const) }
+    await expect(imagePromptAdmission(service, resolver(undefined), provider, model)).resolves.toBe(true)
+    expect(service.admit).toHaveBeenCalledWith({ provider, model, capability: 'unknown', resolution: 'resolved' })
+  })
+
+  it('bridges a failed model resolution, else rethrows the resolver error', async () => {
+    const failing = async () => { throw new Error('endpoint down') }
+    const bridging = { admit: vi.fn(async () => 'bridge' as const) }
+    await expect(imagePromptAdmission(bridging, failing, provider, model)).resolves.toBe(true)
+    expect(bridging.admit).toHaveBeenCalledWith({ provider, model, capability: 'unknown', resolution: 'failed' })
+    const abstaining = { admit: vi.fn(async () => 'abstain' as const) }
+    await expect(imagePromptAdmission(abstaining, failing, provider, model)).rejects.toThrow('endpoint down')
+  })
+})
