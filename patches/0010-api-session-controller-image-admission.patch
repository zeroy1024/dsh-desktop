 /** Implements Session business commands delegated by the Session Controller Remote service. */
+
+// ---------------------------------------------------------------------------
+// patches/0010 — optional image-prompt admission seam.
+//
+// The Web prompt's image admission lives inside the session controller, where
+// a plugin cannot express "bridged" before attachments persist. The seam asks
+// an optional `imageInputAdmission` service without disguising the bridge as
+// a Provider-native image capability: `inputModalities` keeps reporting the
+// native facts, and an absent service (or an abstain verdict) leaves the
+// upstream text-only rejection untouched.
+//
+
+/** Image input capability as resolved from the exact model metadata. */
+export type ImageAdmissionCapability = 'native' | 'text-only' | 'unknown'
+
+/** Admission ask: identity, resolved capability, and whether resolution succeeded. */
+export interface ImageAdmissionRequest {
+  provider: string
+  model: string
+  capability: ImageAdmissionCapability
+  resolution: 'resolved' | 'failed'
+}
+
+/** Optional plugin-side service; 'bridge' admits the image, anything else abstains. */
+export interface ImageInputAdmissionService {
+  admit: (request: ImageAdmissionRequest) => 'bridge' | 'abstain' | Promise<'bridge' | 'abstain'>
+}
+
+/** Minimal model-info face the resolver must return. */
+export interface ResolvedModelInfoLike {
+  inputModalities?: readonly string[] | undefined
+}
+
+/**
+ * Decide whether an image-bearing prompt may proceed.
+ * @returns true when the image is admitted (native capability or a bridge verdict).
+ * @throws whatever `resolveModelInfo` throws when resolution fails un-bridged.
+ */
+export async function imagePromptAdmission(
+  service: unknown,
+  resolveModelInfo: (provider: string, model: string) => Promise<ResolvedModelInfoLike>,
+  provider: string,
+  model: string,
+): Promise<boolean> {
+  const admission = service as ImageInputAdmissionService | undefined
+  const ask = async (capability: ImageAdmissionCapability, resolution: 'resolved' | 'failed'): Promise<boolean> =>
+    (await admission?.admit?.({ provider, model, capability, resolution })) === 'bridge'
+  let capability: ImageAdmissionCapability
+  try {
+    const inputModalities = (await resolveModelInfo(provider, model)).inputModalities
+    capability = inputModalities === undefined
+      ? 'unknown'
+      : inputModalities.includes('image') ? 'native' : 'text-only'
+  } catch (error: unknown) {
+    if (await ask('unknown', 'failed')) return true
+    throw error
+  }
+  if (capability === 'native') return true
+  return ask(capability, 'resolved')
+}
