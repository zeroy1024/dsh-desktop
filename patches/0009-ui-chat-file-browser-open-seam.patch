index 77739e8..9c41407 100644
--- a/packages/client/ui-chat/src/client/apply.ts
+++ b/packages/client/ui-chat/src/client/apply.ts
@@ -120,7 +120,15 @@ export function apply(ctx: Context): void {
           },
           fileMentions: (owner: TurnTailOwnerProps) => ctx.get('chatFileMentions')?.forClosing(owner),
           openFile: async (path) => {
+            // patches/0009: the desktop file-browser seam gets the first look
+            // (tree/preview opens inside the panel). Directories and paths the
+            // browser does not handle fall through to the system opener, and
+            // the service being absent keeps the upstream behavior unchanged.
+            const fileBrowser = ctx.get('fileBrowser') as
+              | { tryOpen?: (request: { sessionId: string; cwd: string | undefined; path: string }) => boolean | Promise<boolean> }
+              | undefined
             const cwd = ctx.sessions.list.getSnapshot().byId[sessionId]?.cwd
+            if (path !== '.' && await fileBrowser?.tryOpen?.({ sessionId, cwd, path: resolveWorkspacePath(cwd, path) }) === true) return
             const result = await ctx.remote.session.openWorkspacePath({
               path: resolveWorkspacePath(cwd, path),
             })
