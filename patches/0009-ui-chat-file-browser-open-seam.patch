+describe('desktop file handoff contract', () => {
+  it('passes the owning session and absolute path, and preserves dot/system fallback', async () => {
+    const b = await bench()
+    const { injected } = b.chatViewApi(ROOT)
+    const tryOpen = vi.fn(async (_request: { sessionId: string; cwd: string | undefined; path: string }) => true)
+    b.runtime.ctx.provide('fileBrowser', { tryOpen } as never)
+    await injected.openFile('src/a.ts')
+    expect(tryOpen).toHaveBeenCalledWith({ sessionId: ROOT, cwd: '/proj', path: '/proj/src/a.ts' })
+    expect(b.openWorkspacePath).not.toHaveBeenCalled()
+    await injected.openFile('.')
+    expect(tryOpen).toHaveBeenCalledOnce()
+    expect(b.openWorkspacePath).toHaveBeenCalledOnce()
+    tryOpen.mockResolvedValue(false)
+    await injected.openFile('src/b.ts')
+    expect(b.openWorkspacePath).toHaveBeenCalledTimes(2)
+    tryOpen.mockRejectedValue(new Error('preview failed'))
+    await expect(injected.openFile('src/c.ts')).rejects.toThrow('preview failed')
+    expect(b.openWorkspacePath).toHaveBeenCalledTimes(2)
+    await b.runtime.dispose()
+  })
+})
