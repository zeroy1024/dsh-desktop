{
  "name": "deepseek-harness-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "sync:upstream": "tsx scripts/sync-upstream.ts",
    "stage:plugins": "tsx scripts/stage-plugins.ts",
    "rehearse:queue": "tsx scripts/rehearse-queue.ts",
    "test:upstream-patches": "tsx scripts/test-upstream-patches.ts",
    "test:scripts": "vitest run scripts/tests",
    "ci:verify-vendor-lock": "tsx scripts/verify-vendor-lock.ts",
    "ci:probe-native": "tsx scripts/ci-native-probe.ts",
    "ci:probe-electron-sandbox": "tsx scripts/ci-electron-sandbox-probe.ts",
    "ci:smoke:dsh": "tsx scripts/smoke-dsh.ts",
    "ci:smoke:electron": "tsx scripts/smoke-electron.ts",
    "ci:smoke:packaged": "tsx scripts/smoke-packaged.ts",
    "ci:smoke": "pnpm ci:probe-native && pnpm ci:smoke:dsh && pnpm ci:smoke:electron",
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm -r --if-present build && pnpm stage:plugins",
    "test": "pnpm test:scripts && pnpm -r --if-present test",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "lint": "oxlint apps packages scripts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "js-yaml": "^4.2.0",
    "oxlint": "1.76.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
