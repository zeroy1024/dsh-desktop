# CI applies patches and consumes lock/config files on Windows as well as POSIX hosts.
# Keep all textual build inputs on LF so checkout settings cannot change their bytes.
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
# A unified diff prefixes blank context lines with a space. Check the applied
# source tree for whitespace errors instead of treating that syntax as code,
# including a blank context line at the end of the final hunk.
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.svg text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.gif binary
*.icns binary
*.ico binary
*.jpg binary
*.png binary
*.tgz binary
